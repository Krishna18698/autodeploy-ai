# Copy to .env for local development. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Platform
PLATFORM_DOMAIN=autodeploy.localhost
API_PORT=4000

# Postgres (compose)
POSTGRES_USER=autodeploy
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=autodeploy
POSTGRES_PORT=54320
DATABASE_URL=postgres://autodeploy:change-me-local@127.0.0.1:54320/autodeploy

# Valkey (compose)
VALKEY_PASSWORD=change-me-local
VALKEY_PORT=63790
VALKEY_URL=redis://:change-me-local@127.0.0.1:63790

# Object storage — SeaweedFS locally, Backblaze B2 in production
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=autodeploy
S3_ACCESS_KEY_ID=autodeploy
S3_SECRET_ACCESS_KEY=change-me-local-s3

# Kafka (compose)
KAFKA_PORT=9092
KAFKA_BROKERS=127.0.0.1:9092

# API
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Generate: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=1:REPLACE_WITH_32_BYTES_BASE64
# Shared secret between the edge Worker and the API (local route resolution)
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_STRING_AT_LEAST_24_CHARS
WORK_DIR=/tmp/autodeploy
# Local development conveniences — the API refuses to start with these in production
DEV_LOGIN=true
ALLOW_LOCAL_SOURCES=true
# Optional: a personal GitHub token raises the public API limit from 60 to 5000 req/h
GITHUB_TOKEN=
# GitHub App (Phase 2 account step) — leave empty until the app exists
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
ALLOWED_GITHUB_LOGINS=
