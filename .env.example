# Copy to .env for local development. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Platform
PLATFORM_DOMAIN=autodeploy.localhost
API_PORT=4000

# Postgres (compose)
POSTGRES_USER=autodeploy
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=autodeploy
POSTGRES_PORT=54320
DATABASE_URL=postgres://autodeploy:change-me-local@127.0.0.1:54320/autodeploy

# Valkey (compose)
VALKEY_PASSWORD=change-me-local
VALKEY_PORT=63790
VALKEY_URL=redis://:change-me-local@127.0.0.1:63790

# Object storage — SeaweedFS locally, Backblaze B2 in production
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=autodeploy
S3_ACCESS_KEY_ID=autodeploy
S3_SECRET_ACCESS_KEY=change-me-local-s3
