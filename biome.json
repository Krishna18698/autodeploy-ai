{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.next",
      "!**/.wrangler",
      "!**/next-env.d.ts",
      "!tests/fixtures",
      "!tests/corpus/repos",
      "!tests/corpus/report-*.json",
      "!.dev",
      "!**/test-results",
      "!project",
      "!playwright-report",
      "!tests/e2e/results.json",
      "!tests/load/config.json",
      "!tests/security/zap",
      "!tests/demo/acme-shop",
      "!tests/e2e/fixtures/*/build",
      "!tests/e2e/fixtures/*/.svelte-kit",
      "!tests/e2e/fixtures/*/.output",
      "!tests/e2e/fixtures/*/.nuxt",
      "!tests/e2e/fixtures/*/.astro",
      "!tests/e2e/fixtures/*/package-lock.json",
      "!tests/e2e/fixtures/**/*.astro",
      "!tests/e2e/fixtures/**/*.vue",
      "!tests/e2e/fixtures/**/*.svelte",
      "!.vercel"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noUndeclaredEnvVars": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
