// Grafana Alloy on the VM: scrapes the worker's Prometheus endpoint and
// forwards to Grafana Cloud (free tier: 10k series). Traces/metrics from the
// API and worker go straight to the OTLP gateway via OTEL_* env vars.
prometheus.scrape "worker" {
  targets         = [{ __address__ = "worker:9464", service = "autodeploy-worker" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_API_KEY")
    }
  }
}
