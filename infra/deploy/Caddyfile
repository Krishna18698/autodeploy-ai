# Internal reverse proxy: Cloudflare Tunnel → Caddy → the API replicas
# (api.<domain>). The dashboard no longer passes through here: app.<domain>
# points at Vercel and the browser calls the API itself (ADR 0009).
# Active health checks take a replica out of rotation while it restarts.
(api) {
	reverse_proxy api-1:4000 api-2:4000 {
		lb_policy round_robin
		lb_retries 2
		health_uri /readyz
		health_interval 3s
		health_timeout 2s
		# Server-Sent Events: stream immediately, never buffer.
		flush_interval -1
	}
}

:8080 {
	import api
}
