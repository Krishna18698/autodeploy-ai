{
  "name": "@autodeploy/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --import @autodeploy/telemetry/register src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "replay:analytics": "tsx --env-file=../../.env src/replay.ts analytics",
    "sandbox:images": "bash ../../infra/sandbox/build-images.sh"
  },
  "dependencies": {
    "@autodeploy/ai": "workspace:*",
    "@autodeploy/contracts": "workspace:*",
    "@autodeploy/core": "workspace:*",
    "@autodeploy/crypto": "workspace:*",
    "@autodeploy/db": "workspace:*",
    "@autodeploy/events": "workspace:*",
    "@autodeploy/github": "workspace:*",
    "@autodeploy/queue": "workspace:*",
    "@autodeploy/resilience": "workspace:*",
    "@autodeploy/storage": "workspace:*",
    "@autodeploy/telemetry": "workspace:*",
    "iovalkey": "0.4.0",
    "postgres": "3.4.9",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
