{
  "name": "autodeploy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.3",
    "typescript": "7.0.2"
  }
}
