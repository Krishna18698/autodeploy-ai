{
  "name": "autodeploy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env down",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "corpus": "tsx tests/corpus/run.ts",
    "corpus:generate": "tsx tests/corpus/generate.ts",
    "chaos": "tsx tests/chaos/run.ts",
    "load": "tsx tests/load/run.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:smoke": "playwright test -c tests/e2e/smoke.config.ts",
    "keys:check": "tsx scripts/check-keys.ts",
    "github-app": "node scripts/github-app.mjs"
  },
  "devDependencies": {
    "@autodeploy/ai": "workspace:*",
    "@autodeploy/api": "workspace:*",
    "@autodeploy/contracts": "workspace:*",
    "@autodeploy/core": "workspace:*",
    "@autodeploy/crypto": "workspace:*",
    "@autodeploy/db": "workspace:*",
    "@autodeploy/events": "workspace:*",
    "@autodeploy/github": "workspace:*",
    "@autodeploy/queue": "workspace:*",
    "@autodeploy/resilience": "workspace:*",
    "@autodeploy/storage": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@testcontainers/kafka": "12.2.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "26.6.2",
    "iovalkey": "0.4.0",
    "postgres": "3.4.9",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vitest": "5.0.3"
  }
}
